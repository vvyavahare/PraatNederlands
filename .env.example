# ==============================================================================
# NEDERLANDS B1-B2 AI TUTOR & VOICE LAB - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your secrets.
# ==============================================================================

# --- AI & LLM CONFIGURATION ---
# GEMINI_API_KEY: Required for live Gemini AI conversational evaluation.
# Users configure this in AI Studio via Settings > Secrets, or set it below.
GEMINI_API_KEY="your_gemini_api_key_here"

# --- APPLICATION HOSTING ---
# APP_URL: The URL where this applet is hosted (e.g. Cloud Run service URL).
APP_URL="https://ais-pre-w3todocm2sj6zpuveucosv-854317112285.asia-southeast1.run.app"
PORT="3000"
NODE_ENV="development"

# --- SECURITY & AUTHENTICATION ---
# JWT_SECRET: Secret key used to sign and verify session tokens
JWT_SECRET="your_super_secret_jwt_key_here_change_in_production"

# --- POSTGRESQL DATABASE CONFIGURATION (OPTIONAL) ---
# Default to in-memory store if unconfigured; provide credentials for live PostgreSQL
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="nederlands_tutordb"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"

# --- REDIS CACHE & RATE LIMITING CONFIGURATION (OPTIONAL) ---
# Default to in-memory store if unconfigured; provide credentials for live Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="your_redis_password_here"

# --- OAUTH 2.0 IDENTITY PROVIDERS (OPTIONAL) ---
# Google OAuth 2.0 credentials
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# GitHub OAuth 2.0 credentials
GITHUB_CLIENT_ID="your_github_client_id_here"
GITHUB_CLIENT_SECRET="your_github_client_secret_here"
